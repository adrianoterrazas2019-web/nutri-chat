<div class="chat-container">
  <%= link_to "← #{@chat.meal.name}", meal_path(@chat.meal) %>

  <h1>NutriChat</h1>

  <h2 id="chat_title"><%= @chat.title %></h2>

  <% @chat.messages.each do |message| %>
    <p>
      <strong><%= message.role %></strong>
      <%= raw(render_markdown(message.content)) %>
    </p>
  <% end %>

  <div id="new_message_container">
    <%= simple_form_for [@chat, @message] do |f| %>
      <%= f.input :content, label: "Describe your meal here...", required: true, placeholder: "A BigMac with medium fries and a light Coke..." %>
      <%= f.button :submit, 'Send', class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>
