<div class="chat-container">
  <%= link_to "← Back to #{@chat.meal.title}", meal_path(@chat.meal) %>

  <h1>NutriChat</h1>
  <div>
    <%# TODO: Change this div with a partial %>
    <h1><%= @meal.title %></h1>

    <p>
      <%= @meal.description %>
    </p>

    <ul>
      <li>Calories: <%= @meal.calories_kcal %> kcal</li>
      <li>Protein: <%= @meal.protein_g %> g</li>
      <li>Carbohydrates: <%= @meal.carbohydrates_g %> g</li>
      <li>Fat: <%= @meal.fat_g %> g</li>
      <li>Sugar: <%= @meal.sugar_g %> g</li>
      <li>Nutri score: <%= @meal.nutri_score %></li>
      <li>Contains gluten: <%= @meal.contains_gluten %></li>
      <li>Contains lactose: <%= @meal.contains_lactose %></li>
    </ul>
  </div>
  <div>
    <h2 id="chat_title"><%= @chat.title %></h2>


    <div id="messages">
      <%= render "messages/messages", messages: @chat.messages  %>
    </div>

    <div id="new_message_container">
      <%= render "messages/form", chat: @chat, message: @message %>
    </div>




    <%# TODO : Check this form and fix it
    <%# <div id="messages"> %>
      <%# <%= render "messages/messages", messages: @chat.messages  %>
    <%# </div> %>

    <%# <div id="new_message_container"> %>
      <%# <%= render "messages/form", chat: @chat, message: @message %>
    <%# </div> %>

  </div>
</div>
