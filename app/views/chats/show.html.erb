<div class="chat-page-container">

  <div class="chat-layout">

    <!-- LEFT: MEAL -->
    <div class="chat-meal-card">

      <%= link_to "← Back to meal", meal_path(@chat.meal), class: "back-link" %>

      <h1 class="chat-meal-title"><%= @meal.title %></h1>

      <p class="chat-meal-description">
        <%= @meal.description %>
      </p>

      <ul class="chat-nutrition">
        <li>Calories: <%= @meal.calories_kcal %> kcal</li>
        <li>Protein: <%= @meal.protein_g %> g</li>
        <li>Carbs: <%= @meal.carbohydrates_g %> g</li>
        <li>Fat: <%= @meal.fat_g %> g</li>
        <li>Sugar: <%= @meal.sugar_g %> g</li>
        <li>Nutri score: <%= @meal.nutri_score %></li>
        <li>Gluten: <%= @meal.contains_gluten %></li>
        <li>Lactose: <%= @meal.contains_lactose %></li>
      </ul>

    </div>

    <!-- RIGHT: CHAT -->
    <div class="chat-main-card">

      <h2 class="chat-title">
        <%= @chat.title %>
      </h2>

      <div id="messages" class="chat-messages">
        <%= render "messages/messages", messages: @chat.messages %>
      </div>

      <div id="new_message_container" class="chat-input">
        <%= render "messages/form", chat: @chat, message: @message %>
      </div>

    </div>

  </div>

</div>
