<div class="chat-container">
  <%= link_to "← #{@chat.meal.title}", meal_path(@chat.meal) %>

  <h1>NutriChat</h1>

  <h2 id="chat_title"><%= @chat.title %></h2>

  <% @chat.messages.each do |message| %>
    <p>
      <strong><%= message.role %></strong>
      <%= raw(render_markdown(message.content)) %>
    </p>
  <% end %>

  <%# TODO : Check this form and fix it  %>
  <%= form_with url: "/search", model: @chat do |form| %>
    NutriChat:
    <ul>
      <%= form.fields_for :message do |message_form| %>
        <li>
          <%= message_form.label :content, "Describe your meal here..." %>
          <%= message_form.text_field :content %>
          <%= message_form.submit %>
        </li>
      <% end %>
    </ul>
  <% end %>

</div>
