<div class="min-h-screen bg-[#edf6f0] py-10">
  <div class="max-w-md mx-auto px-4">
    <div class="bg-white border border-gray-300 rounded-lg p-6 shadow-sm">

      <h2 class="text-2xl font-semibold mb-6">Log in</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="mb-4">
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "w-full border border-gray-300 rounded-md px-3 py-2" %>
        </div>

        <div class="mb-4">
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "w-full border border-gray-300 rounded-md px-3 py-2" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="mb-4">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, class: "text-sm text-gray-700" %>
          </div>
        <% end %>

        <%= f.submit "Log in",
            class: "w-full px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition" %>

      <% end %>

      <div class="mt-4 text-sm">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
