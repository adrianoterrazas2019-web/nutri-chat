<h1>Edit Meal</h1>

<%= form_with model: @meal do |f| %>

  <p>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </p>

  <p>
    <%= f.label :nutritional_info %><br>
    <%= f.text_area :nutritional_info %>
  </p>

  <%= f.submit "Save Changes" %>

<% end %>
