<div id="edit-form" class="meal-show-card">

  <h2 class="section-title text-green-600 mb-6">
    Please describe your meal
  </h2>

  <%= form_with model: @meal do |form| %>

    <%= form.text_area :description, class: "form-textarea" %>

    <%= form.submit "Create Meal", class: "meal-button" %>

  <% end %>

</div>
