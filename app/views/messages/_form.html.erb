<%= form_with model: @chat,
              url: chat_messages_path(@chat),
              method: :post do |form| %>

  <%= form.fields_for :message do |message_form| %>

    <%= message_form.text_field :content,
          placeholder: "Ask about your meal...",
          class: "chat-text-field" %>

    <%= message_form.submit "Save chat",
          class: "chat-submit-button" %>

  <% end %>

<% end %>
